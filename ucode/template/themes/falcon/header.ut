{%
	import { getuid, getspnam } from "luci.core";

	const boardinfo = ubus.call("system", "board") ?? {};
	const hostname = striptags(boardinfo?.hostname ?? "OpenWrt");
	const theme_rev = `${version?.luciversion ?? 'dev'}-${time()}`;

	http.prepare_content("text/html; charset=UTF-8");
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, viewport-fit=cover">
	<title>{{ (title ? title + " - " : "") + hostname }} - LuCI</title>
	<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ theme_rev }}">
	<link rel="stylesheet" href="{{ media }}/mobile.css?v={{ theme_rev }}">
	<link rel="stylesheet" href="{{ media }}/theme.css?v={{ theme_rev }}">
	<link rel="icon" href="{{ media }}/logo_48.png" sizes="48x48">
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ theme_rev }}"></script>
	<script src="{{ resource }}/luci.js"></script>
</head>
<body class="lang_{{ dispatcher.lang }} {{ entityencode(join('-', ctx.request_path), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
{% if (!blank_page): %}
<div class="falcon-layout">
	<!-- 移动端暗色遮罩层 -->
	<div class="falcon-backdrop" id="falconBackdrop" onclick="toggleSidebar(false)"></div>

	<!-- 左侧垂直侧边栏 (Sidebar) -->
	<aside class="falcon-sidebar" id="falconSidebar">
		<div class="sidebar-brand">
			<a href="{{ dispatcher.build_url() }}" class="brand-link">
				<span class="brand-logo-badge">FH</span>
				<div class="brand-meta">
					<span class="brand-name">{{ hostname }}</span>
					<span class="brand-desc">FiberHome 万兆网关</span>
				</div>
			</a>
			<button class="sidebar-close-btn" onclick="toggleSidebar(false)" title="关闭菜单">✕</button>
		</div>

		<!-- 垂直导航菜单区 (由 LuCI menu 引擎注入) -->
		<div class="sidebar-nav-container">
			<ul class="nav" id="topmenu"></ul>
		</div>

		<!-- 侧边栏底部操作区 -->
		<div class="sidebar-bottom">
			<a href="{{ dispatcher.build_url('admin/logout') }}" class="sidebar-logout">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
					<polyline points="16 17 21 12 16 7"></polyline>
					<line x1="21" y1="12" x2="9" y2="12"></line>
				</svg>
				<span>退出系统</span>
			</a>
		</div>
	</aside>

	<!-- 右侧主内容区域 -->
	<div class="falcon-content-pane">
		<!-- 顶部轻量状态栏 (Top Bar) -->
		<header class="falcon-top-bar">
			<div class="top-bar-left">
				<button class="mobile-menu-trigger" onclick="toggleSidebar(true)" title="展开侧边栏">
					<span class="burger-line"></span>
					<span class="burger-line"></span>
					<span class="burger-line"></span>
				</button>
				<div class="top-breadcrumbs">
					<span class="crumb-lead">控制台</span>
					<span class="crumb-slash">/</span>
					<span class="crumb-current">{{ dispatched?.title ? _(dispatched.title) : '概览' }}</span>
				</div>
			</div>
			<div class="top-bar-right">
				<div id="indicators" class="pull-right"></div>
			</div>
		</header>

		<main id="maincontent" class="container">
			<noscript>
				<div class="alert-message warning">
					<h4>JavaScript required!</h4>
				</div>
			</noscript>
			<div id="tabmenu" style="display:none"></div>
			<div id="view">
{% endif %}
