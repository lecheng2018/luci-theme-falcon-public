{% if (!blank_page): %}
			</div>
		</main>
		<footer class="luci-footer">
			Powered by {{ version.luciname }} ({{ version.luciversion }}) / {{ version.distname }} {{ version.distversion }}
		</footer>
		<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
	</div><!-- /.falcon-content-pane -->
</div><!-- /.falcon-layout -->

<script>
function toggleSidebar(show) {
	var sb = document.getElementById('falconSidebar');
	var bd = document.getElementById('falconBackdrop');
	if (!sb) return;
	if (show === undefined) show = !sb.classList.contains('open');
	if (show) {
		sb.classList.add('open');
		if (bd) bd.classList.add('open');
		document.body.classList.add('sidebar-open');
	} else {
		sb.classList.remove('open');
		if (bd) bd.classList.remove('open');
		document.body.classList.remove('sidebar-open');
	}
}

// 侧边栏菜单交互：点击一级菜单展开/折叠，绝不在鼠标滑过时抽动展开
document.addEventListener('DOMContentLoaded', function() {
	var menu = document.getElementById('topmenu');
	if (menu) {
		menu.addEventListener('click', function(e) {
			var a = e.target.closest('a');
			if (!a) return;
			var href = a.getAttribute('href');
			var li = a.closest('#topmenu > li');

			/* 如果点击的是带子菜单的一级菜单项（href 为 # 或无有效链接） */
			if (li && (href === '#' || !href || href === 'javascript:void(0)')) {
				e.preventDefault();
				e.stopPropagation();
				li.classList.toggle('open');
			} else if (href && href !== '#') {
				if (window.innerWidth <= 854) {
					toggleSidebar(false);
				}
			}
		});

		// 页面初次加载时，自动展开当前正在访问的菜单分类
		var observer = new MutationObserver(function() {
			var currentPath = window.location.pathname;
			var links = menu.querySelectorAll('.dropdown-menu a');
			if (links.length > 0) {
				links.forEach(function(link) {
					var href = link.getAttribute('href');
					if (href && (currentPath === href || (currentPath.indexOf(href) === 0 && href !== '/'))) {
						var parentLi = link.closest('#topmenu > li');
						if (parentLi) {
							parentLi.classList.add('open');
							parentLi.classList.add('active');
						}
						link.classList.add('active');
					}
				});
				observer.disconnect();
			}
		});
		observer.observe(menu, { childList: true, subtree: true });
	}
});

L.require('menu-bootstrap');
</script>
{% endif %}
</body>
</html>
