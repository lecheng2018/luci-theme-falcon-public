{% include('header', { blank_page: true }) %}

{#
 luci-theme-falcon login — markup mirrors the reference design's centered
 card. The form POSTs luci_username/luci_password to the current URL, exactly
 like the stock template; falcon.sysauth only wires focus + spinner behavior.
-#}

{%
	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo?.hostname ?? 'OpenWrt');
-%}

<div class="fx-root">
	<div class="login-container">
		<div class="login-box">
			<div class="login-head">
				<div class="brand-icon">FH</div>
				<h2>{{ _('登录到') }} {{ hostname }}</h2>
				<p>{{ boardinfo?.model ?? 'OpenWrt' }} · 管理控制台</p>
			</div>

			<form method="post" class="fx-login-form">
				<div class="form-group">
					<label for="luci_username">{{ _('用户名') }}</label>
					<input type="text" class="form-input" id="luci_username" name="luci_username"
						autocomplete="username" value="{{ entityencode(duser ?? 'root', true) }}">
				</div>

				<div class="form-group">
					<label for="luci_password">{{ _('管理密码') }}</label>
					<input type="password" class="form-input" id="luci_password" name="luci_password"
						autocomplete="current-password">
				</div>

				{% if (fuser): %}
				<div class="alert-message error" data-login-error style="display:none">
					{{ _('用户名或密码错误，请重试。') }}
				</div>
				{% endif %}

				<button type="submit" class="btn btn-primary btn-login">{{ _('登 录') }}</button>
			</form>

			<div class="login-version">
				{{ version.distname }} {{ version.distversion }} · {{ version.luciname }}
			</div>
		</div>
	</div>
</div>

<div id="view" style="display:none"></div>
<script>
	L.require('ui').then(function(ui) {
		ui.instantiateView('falcon.sysauth');
	});
</script>

{% include('footer', { blank_page: true }) %}
