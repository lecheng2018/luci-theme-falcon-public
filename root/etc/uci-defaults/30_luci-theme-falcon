#!/bin/sh

uci batch <<-EOF
	set luci.themes.Falcon=/luci-static/falcon
	set luci.main.mediaurlbase=/luci-static/falcon
	commit luci
EOF

# Fix FiberHome HG5585F CT board.json if lan1 was erroneously assigned as wan
if [ -f /etc/board.json ] && grep -q '"fiberhome,hg5585f-ct"' /etc/board.json; then
	if grep -q '"device": "lan1"' /etc/board.json; then
		sed -i 's/"device": "lan1"/"device": "pon0"/g' /etc/board.json
		if ! grep -q '"lan1"' /etc/board.json; then
			sed -i '/"ports": \[/a \				"lan1",' /etc/board.json
		fi
	fi
fi

exit 0
