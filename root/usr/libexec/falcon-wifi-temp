#!/bin/sh
# Falcon theme helper: WiFi radio temperatures via iwpriv (MTK SDK driver).
#
# Fully dynamic: enumerates every wireless device reported by iwinfo and probes
# each one; devices that do not report CurrentTemperature (client VIFs such as
# apcli*, extra VAPs on some drivers) are skipped automatically.
# Output: JSON {"ra0": 53, "rai0": 55, ...} — {} when nothing reports.

first=1
out=''

for dev in $(iwinfo 2>/dev/null | awk '/^[a-z0-9]+[[:space:]]/ {print $1}' | sort -u); do
	t=$(iwpriv "$dev" stat 2>/dev/null |
		sed -n 's/^CurrentTemperature[[:space:]]*=[[:space:]]*//p' |
		head -n 1)
	[ -n "$t" ] || continue

	case "$t" in
		*[0-9]*) ;;
		*) continue ;;
	esac

	if [ "$first" = 1 ]; then
		out="\"$dev\": $t"
		first=0
	else
		out="$out, \"$dev\": $t"
	fi
done

printf '{%s}' "$out"
